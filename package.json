{
  "name": "gottofrotto-backend-fresh",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=1536' npx medusa build && ln -sf .medusa/server/public/ public",
    "postbuild": "echo 'Build completed. Admin files:' && ls -la .medusa/server/public/admin/ || echo 'Admin directory not found'",
    "create-admin": "npx medusa exec ./scripts/create-admin.js --",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "./start.sh",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/draft-order": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/notification": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/knex": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/postgresql": "6.6.14",
    "@swc/core": "^1.7.28",
    "awilix": "^8.0.1",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.16.3",
    "react-router-dom": "^7.18.4",
    "resend": "^6.28.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.0",
    "@mikro-orm/cli": "6.6.14",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "axios": "^1.18.0",
    "body-parser": "^1.20.6",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@5": "^5.0.9",
    "form-data": "^4.0.6",
    "js-yaml@3": "^3.15.2",
    "lodash": "^4.18.1",
    "nanoid@3": "^3.3.18",
    "postcss": "^8.5.23",
    "qs": "^6.16.0"
  }
}
