NODE_ENV=production

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# CORS — set to your domain(s)
STORE_CORS=https://your-domain.com
ADMIN_CORS=https://your-domain.com
AUTH_CORS=https://your-domain.com

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# Redis (optional — uses in-memory if not provided)
# REDIS_URL=redis://localhost:6379

# Resend email provider
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=noreply@your-domain.com

# Password reset URL (used in reset emails)
# ADMIN_RESET_PASSWORD_URL=https://your-domain.com/app/reset-password

# Server
PORT=9000
